# Photo library. On the bulk disk — /home is only 76G and the library is ~185 GiB.
UPLOAD_LOCATION=/mnt/0_data/immich

# Database. Must be local storage, never a network share. Kept under /home so the
# nightly restic run covers it — this is the irreplaceable part (albums, metadata),
# the photos themselves are excluded and live in Jottacloud.
DB_DATA_LOCATION=/home/immich/postgres

TZ=Europe/Oslo

# Pin to a release. `v3` is a moving tag and would upgrade unattended on the backup
# script's nightly `up -d`.
IMMICH_VERSION=v3.1.0

# openssl rand -hex 24   (A-Za-z0-9 only — no special characters)
DB_PASSWORD=

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
