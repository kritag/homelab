# Copy to ~/.env and fill in proper values.

PUID=2020
PGID=2020
TZ=Europe/Oslo

# --- binhex/arch-qbittorrentvpn ---
VPN_ENABLED=yes
VPN_PROV=
VPN_CLIENT=openvpn
VPN_USER=
VPN_PASS=
STRICT_PORT_FORWARD=yes
DEBUG=false

# LAN CIDR — required, or the container blocks access from your network
LAN_NETWORK=192.168.0.0/24,172.16.0.0/12
NAME_SERVERS=1.1.1.1,1.0.0.1
ENABLE_PRIVOXY=yes

# Must match both sides of the published port in docker-compose.yaml
QBIT_WEBUI_PORT=8181

# --- recyclarr: Radarr/Sonarr > Settings > General, after first start ---
RADARR_API_KEY=
SONARR_API_KEY=
